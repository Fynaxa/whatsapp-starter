# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Permanent system user token from the Meta app (Graph API access).
WHATSAPP_TOKEN=EAAG...

# Numeric id of the sending number, not the number itself.
PHONE_NUMBER_ID=123456789012345

# App secret from Meta App Dashboard > App settings > Basic.
# Used to verify X-Hub-Signature-256 on every inbound webhook.
APP_SECRET=0123456789abcdef0123456789abcdef

# A random string you invent. Meta echoes it back during webhook setup.
VERIFY_TOKEN=pick-something-long-and-random

# Optional overrides.
GRAPH_API_VERSION=v21.0
GRAPH_BASE_URL=https://graph.facebook.com
STATE_DIR=.state
